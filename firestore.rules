rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        (request.resource.data.requesterId == request.auth.uid && request.resource.data.status == 'AVAILABLE')
        || isAdmin()
      );

      allow update: if isAuthenticated() && (
        isAdmin()
        ||
        (
          resource.data.status == 'AVAILABLE'
          && resource.data.helperId == null
          && request.resource.data.status == 'IN_PROGRESS'
          && request.resource.data.helperId == request.auth.uid
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.title == resource.data.title
          && request.resource.data.fee == resource.data.fee
        )
        ||
        (
          resource.data.helperId == request.auth.uid
          && request.resource.data.helperId == resource.data.helperId
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.title == resource.data.title
          && request.resource.data.fee == resource.data.fee
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofUri', 'proofName', 'status', 'helperConfirmed', 'requesterConfirmed', 'updatedAt'])
        )
        ||
        (
          resource.data.requesterId == request.auth.uid
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.helperId == resource.data.helperId
          && request.resource.data.title == resource.data.title
          && request.resource.data.fee == resource.data.fee
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofUri', 'paymentProofName', 'status', 'helperConfirmed', 'requesterConfirmed', 'updatedAt'])
        )
        ||
        (
          (resource.data.requesterId == request.auth.uid || resource.data.helperId == request.auth.uid)
          && resource.data.proofUri != null
          && resource.data.paymentProofUri != null
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.helperId == resource.data.helperId
          && request.resource.data.proofUri == resource.data.proofUri
          && request.resource.data.paymentProofUri == resource.data.paymentProofUri
        )
      );

      allow delete: if isAuthenticated() && (
        (resource.data.requesterId == request.auth.uid && resource.data.status == 'AVAILABLE')
        || isAdmin()
      );

      // Job Messages (Requester ↔ Helper Real-Time Chat)
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /applications/{appId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.applicantId ||
        request.auth.uid == request.resource.data.applicantId ||
        isAdmin()
      );
    }

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          (request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == 'user' && request.resource.data.conversationId == conversationId)
          ||
          (request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == 'admin' && isAdmin() && request.resource.data.conversationId == conversationId)
        );
        allow update, delete: if false;
      }
    }
  }
}
